    {
      "parameters": {
        "jsCode": "// Valid8 — junta o pedido com o endereco que a API devolveu.\n//\n// $('Ler e validar o pedido') alcanca a saida de um no anterior: o pedido\n// nao se perde so porque o no do meio foi uma chamada HTTP.\n//\n// A ViaCEP nao devolve 404 pra CEP inexistente: devolve 200 com { erro: true }.\n// Por isso a checagem e no corpo, nao no codigo de status.\n\nconst pedido = $('Ler e validar o pedido').first().json;\nconst cepInfo = $input.first().json;\n\nconst naoEncontrado =\n  cepInfo.erro === true || String(cepInfo.erro) === 'true' || !cepInfo.uf;\n\nconst SUDESTE_SUL = ['SP', 'RJ', 'MG', 'ES', 'PR', 'SC', 'RS'];\n\nlet regiao = 'nao_encontrado';\nif (!naoEncontrado) regiao = SUDESTE_SUL.includes(cepInfo.uf) ? 'sudeste_sul' : 'demais';\n\nreturn [{\n  json: {\n    ...pedido,\n    regiao,\n    endereco: naoEncontrado\n      ? null\n      : {\n          cep: cepInfo.cep,\n          logradouro: cepInfo.logradouro,\n          bairro: cepInfo.bairro,\n          cidade: cepInfo.localidade,\n          uf: cepInfo.uf,\n        },\n  },\n}];"
      },
