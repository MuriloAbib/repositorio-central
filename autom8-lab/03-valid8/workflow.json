    {
      "parameters": {
        "jsCode": "// Valid8 — le o pedido cru e decide se da pra seguir.\n// Validar ANTES de chamar a API externa: nao se gasta requisicao com lixo.\n\nconst corpo = $input.first().json.body ?? $input.first().json;\n\nconst cep = String(corpo.cep ?? '').replace(/\\D/g, '');\nconst itens = Array.isArray(corpo.itens) ? corpo.itens : [];\n\nconst itensLimpos = itens\n  .map((i) => ({\n    sku: String(i.sku ?? '').trim(),\n    nome: String(i.nome ?? '').trim(),\n    qtd: Number(i.qtd ?? 0),\n    preco: Number(i.preco ?? 0),\n  }))\n  .filter((i) => i.sku && i.qtd > 0 && i.preco > 0);\n\nconst subtotal = Number(\n  itensLimpos.reduce((soma, i) => soma + i.qtd * i.preco, 0).toFixed(2)\n);\n\nconst motivos = [];\nif (cep.length !== 8) motivos.push('cep precisa de 8 digitos');\nif (itensLimpos.length === 0) motivos.push('pedido sem item valido');\n\nreturn [{\n  json: {\n    valido: motivos.length === 0,\n    motivo: motivos.join('; ') || null,\n    cliente: String(corpo.cliente ?? '').trim(),\n    cep,\n    itens: itensLimpos,\n    subtotal,\n  },\n}];"
      },
